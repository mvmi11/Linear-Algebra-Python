#!/usr/bin/env python3
"""
Advanced Mathematical & Cryptographic Calculator
- Basic arithmetic
- Symbolic calculus (derivative, indefinite/definite integral)
- Matrix algebra (determinant & inverse) for n x n matrices
- Linear Algebra Cryptography (Image Encryption via Matrix Transformations)

Dependencies:
    pip install numpy sympy matplotlib
"""
from typing import Optional
import sys

import numpy as np
import sympy as sp
import matplotlib.pyplot as plt
from sympy.parsing.sympy_parser import parse_expr
from sympy.core.sympify import SympifyError

np.set_printoptions(precision=6, suppress=True)


def safe_input(prompt: str) -> str:
    try:
        return input(prompt)
    except (EOFError, KeyboardInterrupt):
        print("\nExiting.")
        sys.exit(0)


def get_number(prompt: str, allow_float: bool = True) -> float:
    while True:
        s = safe_input(prompt).strip()
        try:
            if allow_float:
                return float(s)
            else:
                return int(s)
        except ValueError:
            print("Please enter a valid number.")


def basic_calc():
    print("\n--- 🧮 Basic Operations ---")
    num1 = get_number("Enter first number: ")
    while True:
        op = safe_input("Enter operator (+, -, *, /): ").strip()
        if op in {"+", "-", "*", "/"}:
            break
        print("Invalid operator. Choose one of: +, -, *, /")

    num2 = get_number("Enter second number: ")

    try:
        if op == "+":
            result = num1 + num2
        elif op == "-":
            result = num1 - num2
        elif op == "*":
            result = num1 * num2
        elif op == "/":
            if num2 == 0:
                raise ZeroDivisionError
            result = num1 / num2
    except ZeroDivisionError:
        print("Error: Division by zero.")
        return

    if float(result).is_integer():
        print(f"Result: {int(result)}")
    else:
        print(f"Result: {result}")


def parse_expression(expr_str: str, symbol: sp.Symbol) -> Optional[sp.Expr]:
    try:
        local_dict = {str(symbol): symbol}
        expr = parse_expr(expr_str, local_dict=local_dict, evaluate=True)
        return sp.simplify(expr)
    except (SympifyError, SyntaxError, TypeError, ValueError) as e:
        print(f"Failed to parse expression: {e}")
        return None


def calculus_calc():
    print("\n--- 📉 Calculus Operations ---")
    x = sp.Symbol("x")
    expr_str = safe_input("Enter a function of x (e.g., x**2 + 3*x): ").strip()
    expr = parse_expression(expr_str, x)
    if expr is None:
        return

    deriv = sp.diff(expr, x)
    integral_indef = sp.integrate(expr, x)

    print("\nSymbolic results (exact):")
    print(f"1. Derivative (d/dx): {sp.pretty(deriv)}")
    print(f"2. Indefinite Integral (∫ dx): {sp.pretty(integral_indef)} + C")

    choice = safe_input("\nDo you want a numeric evaluation / definite integral? (y/N): ").strip().lower()
    if choice == "y":
        eval_at = safe_input("Evaluate derivative or integral at a point? Enter 'd' or 'i': ").strip().lower()
        if eval_at in {"d", "i"}:
            point = None
            try:
                point = float(safe_input("Enter numeric x value: "))
            except ValueError:
                print("Invalid numeric value.")
                return

            if eval_at == "d":
                numeric = float(sp.N(deriv.subs(x, point)))
                print(f"Derivative at x={point}: {numeric}")
            else:
                numeric = float(sp.N(integral_indef.subs(x, point)))
                print(f"Indefinite integral evaluated at x={point} (without C): {numeric}")
        else:
            try:
                a = float(safe_input("Enter lower limit a: "))
                b = float(safe_input("Enter upper limit b: "))
                definite = sp.integrate(expr, (x, a, b))
                print(f"Definite integral from {a} to {b}: {sp.N(definite)}")
            except ValueError:
                print("Invalid numeric limits.")
            except Exception as e:
                print(f"Failed to compute definite integral: {e}")


def read_matrix(n: int) -> Optional[np.ndarray]:
    print(f"Enter the matrix row by row. Each row should have {n} numbers separated by spaces.")
    rows = []
    for i in range(n):
        row_str = safe_input(f"Row {i + 1}: ").strip()
        parts = row_str.split()
        if len(parts) != n:
            print(f"Row must have exactly {n} entries.")
            return None
        try:
            row = [float(p) for p in parts]
        except ValueError:
            print("Each entry must be a number.")
            return None
        rows.append(row)
    return np.array(rows, dtype=float)


def algebra_calc():
    print("\n--- 📐 Matrix Algebra ---")
    try:
        n = int(get_number("Enter matrix size n for an n x n matrix (e.g., 2): ", allow_float=False))
        if n <= 0:
            print("Matrix size must be positive.")
            return
    except ValueError:
        print("Invalid size.")
        return

    A = read_matrix(n)
    if A is None:
        return

    try:
        det = np.linalg.det(A)
    except Exception as e:
        print(f"Failed to compute determinant: {e}")
        return

    tol = 1e-12
    print(f"Determinant: {det:.6g}")

    if abs(det) < tol:
        print("Matrix is singular or numerically close to singular (no inverse).")
        return

    try:
        inv = np.linalg.inv(A)
        print("Inverse matrix:")
        print(inv)
    except np.linalg.LinAlgError:
        print("Matrix is singular (no inverse).")
    except Exception as e:
        print(f"Failed to compute inverse: {e}")


def cryptography_calc():
    print("\n--- 🔐 Matrix Cryptography (Image Encryption) ---")
    print("Generating a secure 2x2 invertible key matrix...")
    key = np.array([[3, 2], [7, 5]])
    print(f"Key Matrix (A):\n{key}")
    
    print("\nCreating a sample 50x50 numerical grid (cross pattern image)...")
    original_img = np.zeros((50, 50))
    original_img[15:35, :] = 150
    original_img[:, 15:35] = 150
    
    print("Encrypting data via Linear Transformation (Y = X * A mod 256)...")
    orig_shape = original_img.shape
    flattened = original_img.flatten()
    reshaped = flattened.reshape(-1, 2)
    encrypted_reshaped = np.dot(reshaped, key) % 256
    encrypted_img = encrypted_reshaped.flatten()[:2500].reshape(50, 50)
    
    print("Decrypting data via Inverse Matrix transformation (X = Y * A^-1)...")
    inv_key = np.linalg.inv(key)
    decrypted_reshaped = np.dot(encrypted_reshaped, inv_key)
    decrypted_flat = np.round(decrypted_reshaped).astype(int).flatten()
    decrypted_img = decrypted_flat[:2500].reshape(orig_shape)
    
    print("Saving visual plot proof as 'cryptography_proof.png'...")
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    axes[0].imshow(original_img, cmap='gray')
    axes[0].set_title('1. Original Data Input')
    axes[1].imshow(encrypted_img, cmap='gray')
    axes[1].set_title('2. Linear Encrypted Noise')
    axes[2].imshow(decrypted_img, cmap='gray')
    axes[2].set_title('3. Decrypted via Inverse')
    
    for ax in axes:
        ax.axis('off')
    plt.tight_layout()
    plt.savefig('cryptography_proof.png')
    print("✅ Done! Plot saved successfully.")


def main():
    print("✨ Welcome to the Ultimate Advanced Mathematical Solver ✨")
    menu = (
        "\nChoose a mode:\n"
        "1. Basic Calculator\n"
        "2. Calculus (Derivative/Integral)\n"
        "3. Matrix Algebra (n x n)\n"
        "4. Matrix Cryptography (Image Encryption Demo)\n"
        "q. Quit\n"
    )
    while True:
        print(menu)
        choice = safe_input("Choose mode (1, 2, 3, 4 or q): ").strip().lower()
        if choice == "1":
            basic_calc()
        elif choice == "2":
            calculus_calc()
        elif choice == "3":
            algebra_calc()
        elif choice == "4":
            cryptography_calc()
        elif choice in {"q", "quit", "exit"}:
            print("Goodbye!")
            break
        else:
            print("Invalid choice. Try again.")


if __name__ == "__main__":
    main().  # 🧮 Ultimate Advanced Mathematical & Cryptography Solver

